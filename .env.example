# Fill in the API key(s) for the provider(s) you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Highest-quality default baseline for the MedAI QMS search assistant.
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
CHAT_MODEL=gpt-5.5
AGENT_MODEL=gpt-5.5
ENRICHMENT_MODEL=gpt-5.5
EVAL_GRADER_MODEL=gpt-5.5

# Query planning is deterministic first. This model is only for low-confidence
# rewrite/classification fallback.
QUERY_MODEL=gpt-5.4-mini

VECTOR_INDEX=faiss
FAISS_INDEX_TYPE=IndexFlatIP
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
MIN_CHUNK_TOKENS=120
MAX_CHUNK_TOKENS=900
TABLE_CHUNK_TARGET_TOKENS=700
TABLE_CHUNK_MAX_TOKENS=900
TABLE_REPEAT_HEADER=true
CREATE_METADATA_CHUNKS=true
PARENT_SECTION_MAX_TOKENS=1800
ANSWER_CONTEXT_NEIGHBOR_CHUNKS=1
HYBRID_TOP_N_LEXICAL=80
HYBRID_TOP_N_VECTOR=80
HYBRID_TOP_N_METADATA=30
ANSWER_MAX_CHUNKS=12

RERANKER_ENABLED=true
RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
RERANKER_TOP_N_CANDIDATES=80
RERANKER_TOP_K=16
RERANKER_MAX_LENGTH=4096

# Local/dev constrained fallback for machines that cannot run Qwen3-Reranker-4B.
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_TOP_N_CANDIDATES=50
# RERANKER_TOP_K=12
# RERANKER_MAX_LENGTH=1024

QMS_CORPUS_ZIP=Example_QMS_-_MedAI.zip
QMS_INDEX_DIR=.data/qms-index
OPENAI_VECTOR_STORE_STATE=.data/openai/vector_store_state.json
